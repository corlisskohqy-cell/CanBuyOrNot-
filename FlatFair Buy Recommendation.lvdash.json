{
  "datasets": [
    {
      "name": "town_options",
      "displayName": "Town Options",
      "queryLines": [
        "SELECT DISTINCT\n",
        "  town\n",
        "FROM\n",
        "  workspace.flatfair.buy_recommendations\n",
        "ORDER BY\n",
        "  town"
      ]
    },
    {
      "name": "affordable_alternatives",
      "displayName": "Affordable Alternatives",
      "queryLines": [
        "SELECT\n",
        "  town,\n",
        "  flat_type,\n",
        "  ensemble_prediction AS predicted_price,\n",
        "  ROUND(price_momentum, 2) AS price_momentum,\n",
        "  ROUND(model_diff_pct, 1) AS model_diff_pct,\n",
        "  CASE\n",
        "    WHEN models_agree THEN 'PASS'\n",
        "    ELSE 'FAIL'\n",
        "  END AS agreement_check\n",
        "FROM\n",
        "  workspace.flatfair.buy_recommendations\n",
        "WHERE\n",
        "  ensemble_prediction <= :budget\n",
        "  AND models_agree = true\n",
        "  AND ensemble_prediction > 0\n",
        "ORDER BY\n",
        "  ensemble_prediction ASC\n",
        "LIMIT 15"
      ],
      "parameters": [
        {
          "displayName": "Budget",
          "keyword": "budget",
          "dataType": "INTEGER",
          "defaultSelection": {
            "values": {
              "dataType": "INTEGER",
              "values": [
                {
                  "value": "500000"
                }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "price_comparison",
      "displayName": "Price Comparison",
      "queryLines": [
        "SELECT\n",
        "  'Latest Actual' AS metric,\n",
        "  latest_actual_price AS price\n",
        "FROM\n",
        "  workspace.flatfair.buy_recommendations\n",
        "WHERE\n",
        "  town = :town\n",
        "  AND flat_type = :flat_type\n",
        "UNION ALL\n",
        "SELECT\n",
        "  'LightGBM' AS metric,\n",
        "  lgbm_prediction AS price\n",
        "FROM\n",
        "  workspace.flatfair.buy_recommendations\n",
        "WHERE\n",
        "  town = :town\n",
        "  AND flat_type = :flat_type\n",
        "UNION ALL\n",
        "SELECT\n",
        "  'Random Forest' AS metric,\n",
        "  rf_prediction AS price\n",
        "FROM\n",
        "  workspace.flatfair.buy_recommendations\n",
        "WHERE\n",
        "  town = :town\n",
        "  AND flat_type = :flat_type\n",
        "UNION ALL\n",
        "SELECT\n",
        "  'Ensemble' AS metric,\n",
        "  ensemble_prediction AS price\n",
        "FROM\n",
        "  workspace.flatfair.buy_recommendations\n",
        "WHERE\n",
        "  town = :town\n",
        "  AND flat_type = :flat_type\n",
        "UNION ALL\n",
        "SELECT\n",
        "  'Your Budget' AS metric,\n",
        "  :budget AS price\n",
        "FROM\n",
        "  workspace.flatfair.buy_recommendations\n",
        "WHERE\n",
        "  town = :town\n",
        "  AND flat_type = :flat_type"
      ],
      "parameters": [
        {
          "displayName": "Town",
          "keyword": "town",
          "dataType": "STRING",
          "defaultSelection": {
            "values": {
              "dataType": "STRING",
              "values": [
                {
                  "value": "ANG MO KIO"
                }
              ]
            }
          }
        },
        {
          "displayName": "Flat Type",
          "keyword": "flat_type",
          "dataType": "STRING",
          "defaultSelection": {
            "values": {
              "dataType": "STRING",
              "values": [
                {
                  "value": "3 ROOM"
                }
              ]
            }
          }
        },
        {
          "displayName": "Budget",
          "keyword": "budget",
          "dataType": "INTEGER",
          "defaultSelection": {
            "values": {
              "dataType": "INTEGER",
              "values": [
                {
                  "value": "500000"
                }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "flat_type_options",
      "displayName": "Flat Type Options",
      "queryLines": [
        "SELECT DISTINCT\n",
        "  flat_type\n",
        "FROM\n",
        "  workspace.flatfair.buy_recommendations\n",
        "ORDER BY\n",
        "  flat_type"
      ]
    },
    {
      "name": "recommendation_card",
      "displayName": "Recommendation Card",
      "queryLines": [
        "SELECT\n",
        "  CASE\n",
        "    WHEN NOT models_agree THEN 'INCONCLUSIVE - Models Disagree'\n",
        "    WHEN price_momentum < -5 THEN 'WAIT - Prices Declining'\n",
        "    WHEN ensemble_prediction <= :budget THEN 'WORTH BUYING'\n",
        "    ELSE 'OVER BUDGET'\n",
        "  END AS recommendation,\n",
        "  town,\n",
        "  flat_type,\n",
        "  :budget AS budget,\n",
        "  ensemble_prediction AS predicted_price,\n",
        "  ensemble_prediction - :budget AS budget_gap,\n",
        "  model_diff_pct AS model_agreement_pct,\n",
        "  models_agree\n",
        "FROM\n",
        "  workspace.flatfair.buy_recommendations\n",
        "WHERE\n",
        "  town = :town\n",
        "  AND flat_type = :flat_type"
      ],
      "parameters": [
        {
          "displayName": "Town",
          "keyword": "town",
          "dataType": "STRING",
          "defaultSelection": {
            "values": {
              "dataType": "STRING",
              "values": [
                {
                  "value": "ANG MO KIO"
                }
              ]
            }
          }
        },
        {
          "displayName": "Flat Type",
          "keyword": "flat_type",
          "dataType": "STRING",
          "defaultSelection": {
            "values": {
              "dataType": "STRING",
              "values": [
                {
                  "value": "3 ROOM"
                }
              ]
            }
          }
        },
        {
          "displayName": "Budget",
          "keyword": "budget",
          "dataType": "INTEGER",
          "defaultSelection": {
            "values": {
              "dataType": "INTEGER",
              "values": [
                {
                  "value": "500000"
                }
              ]
            }
          }
        }
      ]
    },
    {
