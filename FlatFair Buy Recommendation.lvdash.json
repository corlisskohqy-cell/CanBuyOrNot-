        "    WHEN models_agree THEN 'PASS'\n",
        "    ELSE 'FAIL'\n",
        "  END AS agreement_check,\n",
        "  ROUND(price_momentum, 2) AS price_momentum\n",
        "FROM\n",
        "  workspace.flatfair.buy_recommendations\n",
        "WHERE\n",
        "  town = :town\n",
        "  AND flat_type = :flat_type"
      ],
      "parameters": [
        {
          "displayName": "Town",
          "keyword": "town",
          "dataType": "STRING",
          "defaultSelection": {
            "values": {
              "dataType": "STRING",
              "values": [
                {
                  "value": "ANG MO KIO"
